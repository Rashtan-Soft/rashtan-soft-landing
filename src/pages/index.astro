---
import BaseLayout from "../layouts/BaseLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Rashtan Soft",
  url: "https://www.rashtan-soft.com/",
  email: "admin@rashtan-soft.com",
  founder: {
    "@type": "Person",
    name: "Gavrilo Mumovic"
  }
};
---

<BaseLayout
  title="Gavrilo Mumovic | Backend & Cloud Engineering | Rashtan Soft"
  description="Gavrilo Mumovic builds backend systems, cloud infrastructure and SaaS products through Rashtan Soft."
  socialDescription="Hands-on software engineering, from backend to production."
  page="home"
  schema={schema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Rashtan Soft · Gavrilo Mumovic</p>
        <h1 id="hero-title">Hands-on software engineering, from backend to production.</h1>
        <p class="lede">I build backend systems, cloud infrastructure and SaaS products—mainly with .NET, AWS and Node.js. Rashtan Soft is the business behind my work.</p>
        <div class="hero__actions">
          <a class="button" href="#contact">Discuss a project</a>
          <a class="button button--secondary" href="#portfolio">See selected work</a>
        </div>
        <p class="hero__note">Based in Trebinje, Bosnia and Herzegovina · <a href="https://www.toptal.com/developers/resume/gavrilo-mumovic" target="_blank" rel="noopener noreferrer">View my Toptal profile</a></p>
      </div>

      <div class="signal-panel" aria-hidden="true">
        <div class="signal-panel__label"><span>Engineering focus</span><span>In production</span></div>
        <svg class="signal-map" viewBox="0 0 420 300" role="img">
          <path class="signal-map__line" d="M48 75H153L205 130H356"></path>
          <path class="signal-map__line" d="M47 229H138L205 164H358"></path>
          <path class="signal-map__line--bright" d="M205 78V223"></path>
          <path class="signal-map__line" d="M120 42V106"></path>
          <path class="signal-map__line" d="M286 196V258"></path>
          <circle class="signal-map__node" cx="48" cy="75" r="12"></circle>
          <circle class="signal-map__node" cx="48" cy="229" r="12"></circle>
          <circle class="signal-map__node" cx="120" cy="42" r="12"></circle>
          <circle class="signal-map__node" cx="286" cy="258" r="12"></circle>
          <circle class="signal-map__node" cx="356" cy="130" r="12"></circle>
          <circle class="signal-map__node" cx="358" cy="164" r="12"></circle>
          <circle class="signal-map__node--primary" cx="205" cy="78" r="13"></circle>
          <circle class="signal-map__node--primary" cx="205" cy="223" r="13"></circle>
          <text x="27" y="112">CONTEXT</text>
          <text x="20" y="265">CHANGE</text>
          <text x="87" y="25">SYSTEMS</text>
          <text x="252" y="288">RELEASE</text>
          <text x="316" y="112">OBSERVE</text>
          <text x="322" y="198">OPERATE</text>
          <text x="170" y="58">DESIGN</text>
          <text x="175" y="252">REVIEW</text>
        </svg>
        <div class="signal-panel__footer">
          <span>Approach<strong>Understand first</strong></span>
          <span>Delivery<strong>Build in steps</strong></span>
          <span>Focus<strong>Useful outcomes</strong></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="portfolio" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title">Systems and products I have helped build, improve and operate.</h2>
        </div>
        <p class="section-heading__copy">These are focused engineering stories. Each describes the context and contribution without turning confidential work into a sales claim.</p>
      </div>

      <div class="project-grid">
        <article class="work-card work-card--product">
          <p class="work-card__meta">Own product</p>
          <h3>Dental Lab Guru</h3>
          <p>An operated product for dental laboratory workflows, shaped by the work around software: releases, feedback and ongoing decisions.</p>
          <div class="work-card__footer">
            <a class="text-link" href="/work/dental-lab-guru/">Read the engineering case study</a>
            <a class="text-link" href="https://www.dentallabguru.com/" target="_blank" rel="noopener noreferrer">Visit the product</a>
          </div>
        </article>

        <article class="work-card work-card--systems">
          <p class="work-card__meta">Professional experience</p>
          <h3>Illuvium</h3>
          <p>Backend systems and infrastructure for a game project, with engineering work that extends from architecture into production.</p>
          <div class="work-card__footer">
            <a class="text-link" href="/work/illuvium/">Read the case study</a>
            <ul class="tag-list" aria-label="Relevant areas">
              <li>Backend</li>
              <li>Cloud</li>
            </ul>
          </div>
        </article>

        <article class="work-card work-card--payments">
          <p class="work-card__meta">Professional experience</p>
          <h3>StubHub</h3>
          <p>Payment-processing work within a large, established ticketing system, where careful changes matter as much as new features.</p>
          <div class="work-card__footer">
            <a class="text-link" href="/work/stubhub/">Read the case study</a>
            <ul class="tag-list" aria-label="Relevant areas">
              <li>Payments</li>
              <li>Existing systems</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--surface" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How I help</p>
          <h2 id="services-title">Engineering support built around the work that needs doing.</h2>
        </div>
        <p class="section-heading__copy">The useful scope comes first. Tools support the work; they do not define it.</p>
      </div>

      <div class="offer-grid">
        <article class="offer">
          <span class="offer__number" aria-hidden="true">01</span>
          <h3>Build a product or backend</h3>
          <p>Take a defined product, workflow or backend from initial requirements to production. Work can include APIs, data modelling, integrations, deployment and a React interface where useful.</p>
        </article>
        <article class="offer">
          <span class="offer__number" aria-hidden="true">02</span>
          <h3>Improve an existing system</h3>
          <p>Investigate performance or reliability problems, modernise difficult code, or make a deployment process easier to operate. Start by understanding the system and its constraints.</p>
        </article>
        <article class="offer">
          <span class="offer__number" aria-hidden="true">03</span>
          <h3>Join an engineering team</h3>
          <p>Provide hands-on engineering capacity, architecture input, code review and ownership of a substantial area of work.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container process">
      <div class="process__intro">
        <p class="eyebrow">Working together</p>
        <h2 id="process-title">A clear next step, not a one-size-fits-all package.</h2>
        <p class="section-copy">The right arrangement can be a defined project, ongoing contract work or a separately agreed support plan.</p>
      </div>
      <ol class="process-list">
        <li class="step">
          <span class="step__number" aria-hidden="true">01</span>
          <div>
            <h3>Understand the problem</h3>
            <p>We look at the goal, the current system and the constraints that should shape the work. Larger or uncertain initiatives may need a separate discovery phase.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__number" aria-hidden="true">02</span>
          <div>
            <h3>Agree the next piece of work</h3>
            <p>We define responsibility, deliverables, communication and the commercial arrangement before work begins.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__number" aria-hidden="true">03</span>
          <div>
            <h3>Build and review</h3>
            <p>I share working progress, adapt when the evidence changes and agree what happens after release.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="about-title">
    <div class="container statement-grid">
      <div class="statement">
        <p>Good engineering starts with the actual system, the people using it and the limits that matter.</p>
      </div>
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h2 id="about-title">Gavrilo Mumovic and Rashtan Soft</h2>
        <p>Rashtan Soft is the business behind my work. I am Gavrilo Mumovic, a hands-on software engineer who works across backend systems, cloud infrastructure and software products.</p>
        <p>My experience includes industrial systems, game infrastructure, payment work inside a mature platform and the work of building my own product. I focus on understanding the existing context before making technical decisions.</p>
        <a class="text-link" href="/about/">Read more about my experience</a>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Have a project in mind, or a system that needs attention?</h2>
        <p class="section-copy">Tell me a little about the work and what kind of help you need.</p>
        <div class="contact-details">
          <div class="contact-detail">
            <span>Email</span>
            <a href="mailto:admin@rashtan-soft.com">admin@rashtan-soft.com</a>
          </div>
          <div class="contact-detail">
            <span>Prefer a call?</span>
            <a href="https://calendly.com/gavrilo-mumovic/30min" target="_blank" rel="noopener noreferrer">Choose a time that works</a>
          </div>
          <div class="contact-detail">
            <span>Location</span>
            <span>Trebinje, Bosnia and Herzegovina</span>
          </div>
        </div>
      </div>

      <form class="contact-form" data-contact-form action="https://formspree.io/f/xnjbjqgq" method="post" aria-busy="false">
        <div class="form-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="company">Company <span class="field__optional">optional</span></label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="message">What do you need help with?</label>
          <textarea id="message" name="message" autocomplete="off" required placeholder="A short description of the work, system or question is enough."></textarea>
        </div>
        <div class="field-honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form-actions">
          <button class="button" type="submit">Send message</button>
          <p class="form-note" id="form-note">Or email directly if you prefer.</p>
        </div>
        <div class="form-status" id="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true" hidden></div>
      </form>
    </div>
  </section>

  <script src="../scripts/contact.ts"></script>
</BaseLayout>
