---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Rashtan Soft" noindex minimal>
  <div class="container not-found__content">
    <p class="not-found__code" aria-hidden="true">404</p>
    <p class="eyebrow">Page not found</p>
    <h1>The page you were looking for is not here.</h1>
    <p class="lede">You can return to the home page, browse the selected work or get in touch.</p>
    <div class="button-row"><a class="button" href="/">Return home</a><a class="button button--secondary" href="/#portfolio">See selected work</a></div>
  </div>
</BaseLayout>
