---
import BaseLayout from "../layouts/BaseLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Gavrilo Mumovic",
    jobTitle: "Software Engineer",
    url: "https://www.rashtan-soft.com/about/",
    sameAs: [
      "https://www.linkedin.com/in/gavrilo-mumovic/",
      "https://github.com/gajo357",
      "https://www.toptal.com/developers/resume/gavrilo-mumovic"
    ]
  }
};
---

<BaseLayout
  title="About Gavrilo Mumovic | Rashtan Soft"
  description="About Gavrilo Mumovic, a hands-on software engineer and founder of Rashtan Soft."
  socialType="profile"
  socialDescription="About the engineer and business behind Rashtan Soft."
  page="about"
  schema={schema}
>
  <section class="page-hero" aria-labelledby="about-title">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">About</p>
        <h1 id="about-title">Gavrilo Mumovic and Rashtan Soft</h1>
        <p class="page-hero__summary">I’ve been building software for 13+ years. Most of my recent work has been backend systems, AWS and SaaS products. I still spend most of my time writing code.</p>
      </div>
      <dl class="fact-list">
        <div><dt>Based in</dt><dd>Trebinje, Bosnia and Herzegovina</dd></div>
        <div><dt>Focus</dt><dd>Backend, cloud and product engineering</dd></div>
        <div><dt>Education</dt><dd>MSc and BSc in Electrical Engineering, University of Belgrade</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container profile-layout">
      <aside class="profile-aside">
        <img class="profile-portrait" src="/images/gavrilo-mumovic.webp" width="480" height="480" alt="Gavrilo Mumovic" loading="lazy" decoding="async" />
        <p class="profile-aside__label">Professional profiles</p>
        <div class="profile-aside__links">
        <a class="text-link" href="https://www.linkedin.com/in/gavrilo-mumovic/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="text-link" href="https://github.com/gajo357" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="text-link" href="https://www.toptal.com/developers/resume/gavrilo-mumovic" target="_blank" rel="noopener noreferrer">Toptal</a>
        </div>
      </aside>

      <div class="about-copy">
        <h2>Experience</h2>

        <ol class="timeline" aria-label="Selected experience">
          <li>
            <span class="timeline__label">Illuvium</span>
            <p class="timeline__period">December 2023–Present · Remote</p>
            <h3>Senior Backend Engineer</h3>
            <p>Built Deathmatch from scratch and owned backend architecture, implementation and production operations for several games.</p>
            <a class="text-link" href="/work/illuvium/">Read the Illuvium case study</a>
          </li>
          <li>
            <span class="timeline__label">Viagogo / StubHub</span>
            <p class="timeline__period">September 2022–December 2023 · Remote</p>
            <h3>Senior Software Engineer</h3>
            <p>Built payment integrations and implemented an unused payment insurance flow that contributed nearly $5M in additional revenue.</p>
            <a class="text-link" href="/work/stubhub/">Read the StubHub case study</a>
          </li>
          <li>
            <span class="timeline__label">Rashtan DOO</span>
            <p class="timeline__period">May 2020–Present · Remote</p>
            <h3>Lead Software Engineer</h3>
            <p>Building and operating our own SaaS products, with work spanning product decisions, backend services, frontend implementation and cloud infrastructure.</p>
          </li>
          <li>
            <span class="timeline__label">Calsep A/S</span>
            <p class="timeline__period">October 2012–March 2020 · Copenhagen</p>
            <h3>Software Engineer</h3>
            <p>Worked with scientists and engineers in Oil &amp; Gas. Built a .NET Web API with C# and Python SDKs, creating a new revenue stream for the company.</p>
          </li>
        </ol>

        <p class="eyebrow eyebrow--spaced">Own product</p>
        <h2>Dental Lab Guru</h2>
        <p>I built Dental Lab Guru for dental laboratories to manage cases, production, deadlines and invoicing. I talk directly to the people using it and use their feedback to guide development.</p>
        <a class="text-link" href="/work/dental-lab-guru/">Read the Dental Lab Guru case study</a>

        <p class="eyebrow eyebrow--spaced">The business</p>
        <h2>Working with me</h2>
        <p>I work with clients directly through Rashtan Soft, whether that means building a product, improving an existing system or joining an engineering team.</p>
        <p>We start with a conversation about the work, then agree the scope, responsibilities and how we will work together.</p>
        <a class="button" href="/#contact">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
