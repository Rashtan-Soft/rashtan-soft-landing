---
interface Fact {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  facts: Fact[];
}

const { eyebrow, title, summary, facts } = Astro.props;
---

<section class="page-hero" aria-labelledby="case-title">
  <div class="container page-hero__grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="case-title">{title}</h1>
      <p class="page-hero__summary">{summary}</p>
    </div>
    <dl class="fact-list">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
