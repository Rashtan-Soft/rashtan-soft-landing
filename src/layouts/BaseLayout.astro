---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  page?: "home" | "about" | "privacy";
  socialType?: "website" | "profile" | "article";
  socialDescription?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  minimal?: boolean;
}

const {
  title,
  description,
  page,
  socialType = "website",
  socialDescription = description,
  schema,
  noindex = false,
  minimal = false
} = Astro.props;
const site = "https://www.rashtan-soft.com";
const canonical = new URL(Astro.url.pathname, site).toString();
const socialImage = new URL("/og.png", site).toString();
const socialImageAlt = "Rashtan Soft — Hands-on software engineering. Gavrilo Mumovic · Backend, cloud & SaaS.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#06141a" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Gavrilo Mumovic" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={socialType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {socialDescription && <meta property="og:description" content={socialDescription} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1733" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {socialDescription && <meta name="twitter:description" content={socialDescription} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader page={page} />
    <main id="main-content" class:list={{ "not-found": minimal }}>
      <slot />
    </main>
    <SiteFooter page={page} minimal={minimal} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
